{
  "expo": {
    "name": "Routine App",
    "slug": "steady-routine",
    "scheme": "steady-routine",
    "version": "1.0.2",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F6F0",
    "platforms": [
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6F0",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#101A16",
            "image": "./assets/icon.png"
          }
        }
      ],
      "expo-notifications",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RoutineToday",
              "label": "Routine App · Today",
              "description": "Today's progress and quick habit actions",
              "minWidth": "250dp",
              "minHeight": "220dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "android": {
      "package": "com.nahid.steadyroutine",
      "versionCode": 3,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f48f8d4-28b3-4424-ad70-f226abb8ee70"
      }
    },
    "owner": "nahidmohammed213"
  }
}
